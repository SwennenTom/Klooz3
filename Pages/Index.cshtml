@page
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@model Klooz3.Pages.IndexModel
@{
    <!DOCTYPE html>
    <html lang="nl">

    <head>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description"
              content="Homepage van de website van Project Klooz - leerecosysteem met navigatie-elementen">

        <title>Project Klooz</title>

        <link defer rel="icon" href="/img/favicon.webp">
        <link async rel="stylesheet" href="/css/style.css">

        <link async href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet"
              integrity="sha384-GLhlTQ8iRABdZLl6O3oVMWSktQOp6b7In1Zl3/Jr59b6EGGoI1aFkw7cmDA6j6gD" crossorigin="anonymous">

        <script defer src="https://code.jquery.com/jquery-latest.min.js" type="text/javascript"></script>
        <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-w76AqPfDkMBDXo30jS1Sgez6pr3x5MlQ1ZAGC+nuZB+EYdgRZgiwxhTBTkF7CXvN"
                crossorigin="anonymous"></script>
        <script defer src="/script/script.js"></script>

        <script defer type="text/javascript" src="config.js"></script>
        <script defer type="text/javascript" src="https://cdn.kiprotect.com/klaro/v0.7.18/klaro.js"></script>

    </head>

    <body>
        <div style="float: right;">
            @Html.Partial("_LoginPartial")
        </div>
        <div class="container-fluid">
            <div class="row" id="content">
                
                <!-- Klooz Logo -->

                <div class="col-12 position-fixed top-0 start-0 m-3 kloozLogo">
                    <a href="/index2.html">
                        <img src="/img/KloozLogo/PLACEHOLDER_kloozlogo01_TRANSPARANT.webp" width="234px"
                             alt="Welkom op de website van Project Klooz, leerecosysteem">
                    </a>
                </div>

                <!-- Torentje image in bottom right-->

                <div class="col-12 z-3">
                    <img src="/img/Placeholder/PLACEHOLDER_Toren-Transparent.webp" alt=""
                         class="position-fixed bottom-0 end-0 TorenImage">
                </div>

                <!-- Navigation element with white space column-->
                
                
                <div class="col-xl-6 col-lg-4 col-md-2"></div>
                <div class="col-xl-6 col-lg-8 col-md-10" id="navbar-position">
                    <nav class="nav flex-column">
                        <a class="nav-link" href="@Url.Action("Index","Over", new {area = ""})">OVER</a>
                        <a class="nav-link" href="@Url.Action("Index","Experimenten", new {area = ""})">EXPERIMENTEN</a>
                        <a class="nav-link" href="@Url.Action("Index","Contact", new {area = ""})">CONTACT</a>
                        <a class="nav-link" href="@Url.Action("Index","Agenda", new {area = ""})">AGENDA</a>
                        @if(User.Identity.IsAuthenticated)
                        {
                            <a class="nav-link" href="@Url.Action("Index","Administratie", new { area = "" })">ADMINISTRATIE</a>
                        }
                        
                    </nav>
                </div>
            </div>

            <!-- Footer element-->

            <footer class="footer mt-auto py-3">
                <div class="row">
                    <div class="col-10">
                        <nav>
                            <a target=”_blank” href="https://borgloon.be/">
                                <img src="/img/FooterLogos/logo-borgloon (1).webp"
                                     alt="Link naar de website van de Stad Borgloon" class="footerlogo">
                            </a>
                            <a target=”_blank” href="https://ec.europa.eu/european-social-fund-plus/nl">
                                <img src="/img/FooterLogos/esflogo_large.webp"
                                     alt="Link naar de website van het Europees Sociaal Fonds" class="footerlogo">
                            </a>
                            <a target=”_blank” href="https://www.lidk.be/">
                                <img src="/img/FooterLogos/lidk_logofull_color_1600x1240.webp"
                                     alt="Link naar de website van VZW Link in de Kabel" class="footerlogo">
                            </a>
                        </nav>
                    </div>
                    <div class="col-2"></div>
                </div>
                <p id="copyright">
                    &copy;
                    <script>
                        var currentYear = new Date().getFullYear();
                        var firstYear = 2023;
                        var displayYear = (currentYear > firstYear) ? `${firstYear} - ${currentYear}` : currentYear;
                        document.write(displayYear);
                    </script> <a target="_blank" id="linkdeco" href="https://www.lidk.be/">VZW Link in de Kabel</a> - <a id="linkdeco" class="p-0" href="@Url.Action("Index", "Privacy", new { area = "" })">Privacy beleid</a>
                </p>
            </footer>
            <script>
                // JavaScript
                document.addEventListener("DOMContentLoaded", function () {
                    var footer = document.querySelector(".footer");

                    window.addEventListener("scroll", function () {
                        // Adjust the value (500) based on when you want the footer to appear
                        if (window.scrollY > 500) {
                            footer.classList.add("show");
                        } else {
                            footer.classList.remove("show");
                        }
                    });
                });

                </script>
        </div>

        <!-- Cookie consent popup and script -->

        <div class="cookie-consent-overlay">
            <div id="cookieConsent" class="cookie-consent">
                <p>
                    Deze website gebruikt cookies om uw ervaring te verbeteren.
                    <a href="@Url.Action("Index", "Privacy", new { area = "" })">Privacy beleid</a>
                </p>
                <div class="buttons">
                    <button id="acceptCookiesButton" class="cookie-consent-button">Ok!</button>
                    <button id="refuseCookiesButton" class="cookie-consent-button">Liever niet</button>
                </div>
            </div>
        </div>

        <script>
            // Function to set the cookie for consent
            function setCookie(name, value, days) {
                var expires = "";
                if (days) {
                    var date = new Date();
                    date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
                    expires = "; expires=" + date.toUTCString();
                }
                document.cookie = name + "=" + (value || "") + expires + "; path=/";
            }

            // Function to hide the cookie consent popup
            function hideCookieConsent() {
                var cookieConsentPopup = document.getElementById("cookieConsent");
                var cookieConsentOverlay = document.querySelector(".cookie-consent-overlay");

                cookieConsentPopup.style.display = "none";
                cookieConsentOverlay.style.display = "none";
            }

            // Function to handle the Accept button click
            function handleAcceptClick() {
                setCookie("cookieConsent", "accepted", 365); // Cookie will expire after 1 year
                console.log("Accepted");
                hideCookieConsent();
            }

            // Function to handle the Refuse button click
            function handleRefuseClick() {
                setCookie("cookieConsent", "refused", 365); // Cookie will expire after 1 year
                console.log("refused");
                hideCookieConsent();
            }

            // Check if the consent cookie exists
            if (!document.cookie.includes("cookieConsent=")) {
                console.log("cookieConsentCheck performed");
                document.addEventListener("DOMContentLoaded", function () {
                    var acceptCookiesButton = document.getElementById("acceptCookiesButton");
                    acceptCookiesButton.addEventListener("click", handleAcceptClick);

                    var refuseCookiesButton = document.getElementById("refuseCookiesButton");
                    refuseCookiesButton.addEventListener("click", handleRefuseClick);

                    var cookieConsentPopup = document.getElementById("cookieConsent");
                    cookieConsentPopup.style.display = "block";
                });
            } else {
                hideCookieConsent();
            }
        </script>


    </body>

    </html>
}
