@page
@using Microsoft.AspNetCore.Identity
@using Klooz3.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@model Klooz3.Pages.IndexModel
@{
    <!DOCTYPE html>
    <html lang="nl">

    <head>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description"
              content="Project klooz - leerecosysteem">

        <title>Project Klooz</title>

        <link defer rel="icon" href="/img/favicon.webp">
        <link async rel="stylesheet" href="/css/style.css">

        <link async href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet"
              integrity="sha384-GLhlTQ8iRABdZLl6O3oVMWSktQOp6b7In1Zl3/Jr59b6EGGoI1aFkw7cmDA6j6gD" crossorigin="anonymous">

        <script src="https://code.jquery.com/jquery-latest.min.js" type="text/javascript"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-w76AqPfDkMBDXo30jS1Sgez6pr3x5MlQ1ZAGC+nuZB+EYdgRZgiwxhTBTkF7CXvN"
                crossorigin="anonymous"></script>

        <script defer src="~/script/script.js"></script>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var cookieConsent = document.getElementById("cookieConsent");

                // Check if the user has previously accepted cookies
                var hasAcceptedCookies = localStorage.getItem("cookiesAccepted");

                if (!hasAcceptedCookies) {
                    // Show the cookie consent popup
                    cookieConsent.style.display = "block";
                }

                // Event listener for the "Ok!" button
                document.getElementById("acceptCookies").addEventListener("click", function () {
                    // Set a flag indicating that cookies are accepted
                    localStorage.setItem("cookiesAccepted", "true");

                    // Hide the cookie consent popup
                    cookieConsent.style.display = "none";
                });

                // Event listener for the "Liever niet" button
                document.getElementById("denyCookies").addEventListener("click", function () {
                    // Hide the cookie consent popup
                    cookieConsent.style.display = "none";
                });
            });
        </script>


    </head>

    <body>

        <div id="cookieConsent" style="display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background-color: #000; color: #fff; padding: 15px; border-radius: 5px; box-shadow: 0 0 10px rgba(0, 0, 0, 0.5); text-align: center; z-index: 9999;">
            <p>Wij gebruiken cookies om uw ervaring te verbeteren.</p>
            <p>Lees ons <a href="@Url.Action("Index", "Privacy", new { area = "" })">privacybeleid</a> voor meer informatie.</p>
            <button id="acceptCookies" style="padding: 10px 20px; margin: 0 10px; border: none; border-radius: 3px; cursor: pointer; font-weight: bold; background-color: #4CAF50; color: #fff;">Ok!</button>
            <button id="denyCookies" style="padding: 10px 20px; margin: 0 10px; border: none; border-radius: 3px; cursor: pointer; font-weight: bold; background-color: #FF5733; color: #fff;">Liever niet</button>
        </div>

        <div style="float: right;">
            @Html.Partial("_LoginPartial")
        </div>

        <div class="container-fluid">
            <div class="row" id="content">
                
                <!-- Klooz Logo -->

                <div class="col-12 position-fixed top-0 start-0 m-3 kloozLogo">
                    <a href="/index2.html">
                        <img src="/img/KloozLogo/PLACEHOLDER_kloozlogo01_TRANSPARANT.webp" width="234px"
                             alt="Welkom op de website van Project Klooz, leerecosysteem">
                    </a>
                </div>

                <!-- Torentje image in bottom right-->

                <div class="col-12 z-3">
                    <img src="/img/Placeholder/PLACEHOLDER_Toren-Transparent.webp" alt=""
                         class="position-fixed bottom-0 end-0 TorenImage">
                </div>

                <!-- Navigation element with white space column-->

                <div class="col-xl-6 col-lg-4 col-md-2"></div>
                <div class="col-xl-6 col-lg-8 col-md-10" id="navbar-position">
                    <nav class="nav flex-column">
                        <a class="nav-link" href="@Url.Action("Index","Over", new {area = ""})">OVER</a>
                        <a class="nav-link" href="@Url.Action("Index","Experimenten", new {area = ""})">EXPERIMENTEN</a>
                        <a class="nav-link" href="@Url.Action("Index","Contact", new {area = ""})">CONTACT</a>
                        <a class="nav-link" href="@Url.Action("Index","Agenda", new {area = ""})">AGENDA</a>
                        @if(User.Identity.IsAuthenticated)
                        {
                            <a class="nav-link" href="@Url.Action("Index","Administratie", new { area = "" })">ADMINISTRATIE</a>
                        }
                        
                    </nav>
                </div>
            </div>

            <!-- Footer element-->

            <footer class="footer mt-auto py-3">

                <div class="row">
                    <div class="col-10">
                        <nav>
                            <a target="_blank" href="https://borgloon.be/" ">
                                <img src="/img/FooterLogos/logo-borgloon (1).webp"
                                     alt="Link naar de website van de Stad Borgloon" class="footerlogo">
                            </a>
                            <a target="_blank" href="https://ec.europa.eu/european-social-fund-plus/nl">
                                <img src="/img/FooterLogos/esflogo_large.webp"
                                     alt="Link naar de website van het Europees Sociaal Fonds" class="footerlogo">
                            </a>
                            <a target="_blank" href="https://www.lidk.be/">
                                <img src="/img/FooterLogos/lidk_logofull_color_1600x1240.webp"
                                     alt="Link naar de website van VZW Link in de Kabel" class="footerlogo">
                            </a>
                        </nav>
                    </div>
                    <div class="col-2"></div>
                </div>
                <p id="copyright" style="color: black;">
                    &copy;
                    <script>
                        var currentYear = new Date().getFullYear();
                        var firstYear = 2023;
                        var displayYear = (currentYear > firstYear) ? `${firstYear} - ${currentYear}` : currentYear;
                        document.write(displayYear);
                    </script>
                    <a target="_blank" id="linkdeco" style="color: black;" href="https://www.lidk.be/">VZW Link in de Kabel</a> -
                    <a id="linkdeco" class="p-0 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Privacy" ? "active" : "")"
                       style="color: black;" href="@Url.Action("Index", "Privacy", new { area = "" })">Privacy beleid</a>
                </p>


            </footer>

        </div>
    </body>

    </html>
}                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       