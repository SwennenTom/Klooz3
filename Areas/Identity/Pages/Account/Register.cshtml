@page
@model RegisterModel
@{
    ViewData["Title"] = "Nieuwe gebruiker";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-4">
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            
            <hr />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div  class="form-floating p-1">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                <label asp-for="Input.Email"></label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-floating p-1">
                <input asp-for="Input.Voornaam" class="form-control" autocomplete="on" aria-required="true" />
                <label asp-for="Input.Voornaam"></label>
                <span asp-validation-for="Input.Voornaam" class="text-danger"></span>
            </div>
            <div class="form-floating p-1">
                <input asp-for="Input.Achternaam" class="form-control" autocomplete="on" aria-required="true" />
                <label asp-for="Input.Achternaam"></label>
                <span asp-validation-for="Input.Achternaam" class="text-danger"></span>
            </div>
            <div class="form-floating p-1">
                <input asp-for="Input.Telefoon" class="form-control" autocomplete="on" aria-required="true" />
                <label asp-for="Input.Telefoon"></label>
                <span asp-validation-for="Input.Telefoon" class="text-danger"></span>
            </div>
            <div class="form-floating p-1">
                <input asp-for="Input.Organisatie" class="form-control" autocomplete="on" aria-required="false" />
                <label asp-for="Input.Organisatie"></label>
                <span asp-validation-for="Input.Organisatie" class="text-danger"></span>
            </div>
            <div class="form-floating p-1">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" />
                <label asp-for="Input.Password"></label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="form-floating p-1">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                <label asp-for="Input.ConfirmPassword"></label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-dark">Registreer</button>
        </form>
    </div>
    <div class="col-md-6 col-md-offset-2">
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
