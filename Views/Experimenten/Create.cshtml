@model Klooz3.Models.Experiment

@{
    ViewData["Title"] = "Create";
}

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="experimentImage" class="control-label">Cover Afbeelding</label><br />
                <input type="file" name="experimentCover" />
                <span asp-validation-for="experimentImage" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="experimentName" class="control-label">Naam van het experiment</label>
                <input asp-for="experimentName" class="form-control" />
                <span asp-validation-for="experimentName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="experimentCardBackText" class="control-label">Tekst op achterkant van kaart</label>
                <input asp-for="experimentCardBackText" class="form-control" />
                <span asp-validation-for="experimentCardBackText" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="experimentShortText" class="control-label">Inhoud van het experiment</label>
                <input asp-for="experimentShortText" class="form-control" />
                <span asp-validation-for="experimentShortText" class="text-danger"></span>
            </div>
            @* <div class="form-group">
                <div class="form-check">
                    <input asp-for="experimentPublished" class="form-check-input" />
                    <label asp-for="experimentPublished" class="form-check-label">Openbaar plaatsen?</label>
                </div>
                <span asp-validation-for="experimentPublished" class="text-danger"></span>
            </div> *@
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Terug naar overzicht</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
