@model Klooz3.Models.Experiment

@{
    ViewData["Title"] = "Edit";
}

<hr />
<div class="row">
    <div>
        <a class="btn btn-dark" asp-action="Admin">Terug naar overzicht</a>
    </div>
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="experimentId" />

            <div class="form-group">
                @if (Model.experimentImage != null)
                {
                <label asp-for="experimentImage" class="control-label">Cover Afbeelding</label><br/>
                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.experimentImage)" alt="Current Image" style="max-width: 200px; max-height: 200px;" />
                }
                <input type="file" name="experimentImage" />
                <span asp-validation-for="experimentImage" class="text-danger"></span>

                @* @if (Model.partnerImage != null)
                {
                    <label asp-for="partnerImage" class="control-label">Afbeelding</label>
                    <br />
                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.partnerImage)" alt="Current Image" style="max-width: 200px; max-height: 200px;" />
                    <br />
                }
                <input type="file" name="partnerImageFile" />
                <span asp-validation-for="partnerImage" class="text-danger"></span> *@
            </div>

            <div class="form-group">
                <label asp-for="experimentName" class="control-label"></label>
                <input asp-for="experimentName" class="form-control" />
                <span asp-validation-for="experimentName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="experimentCardBackText" class="control-label"></label>
                <input asp-for="experimentCardBackText" class="form-control" />
                <span asp-validation-for="experimentCardBackText" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="experimentShortText" class="control-label"></label>
                <textarea rows="20" asp-for="experimentShortText" class="form-control" maxlength="5000" />
                <span asp-validation-for="experimentShortText" class="text-danger"></span>
            </div>

            @if (User.IsInRole("Admin") || User.IsInRole("TeamRegie"))
            {
                <div class="form-group">
                    <div class="form-check">
                        <input asp-for="experimentPublished" class="form-check-input" />
                        <label asp-for="experimentPublished" class="form-check-label">Openbaar plaatsen?</label>
                    </div>
                    <span asp-validation-for="experimentPublished" class="text-danger"></span>
                </div>
            }

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-dark" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            // Handle the form submission using AJAX
            $('#editExperimentForm').submit(function (e) {
                e.preventDefault();
                var form = $(this)[0];
                var formData = new FormData(form);

                $.ajax({
                    url: form.action,
                    type: 'POST',
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        // Handle the success response (data) here if needed
                        // For example, display a success message to the user
                        alert('Wijzigingen opgeslagen!');
                    },
                    error: function (xhr, status, error) {
                        // Handle the error here if needed
                        // For example, display an error message to the user
                        alert('Er ging iets mis. Gelieve opnieuw te proberen.');
                    }
                });
            });
        });
    </script>
}
