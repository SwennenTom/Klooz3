@model IEnumerable<Klooz3.Models.UserExperimenten>

@{
    ViewData["Title"] = "Experimenten";
}

<div class="col-xl-3 col-lg-3 col-md-2 col-sm-1 col-0"></div>
<a class="btn btn-dark" asp-action="Create">Nieuw experiment</a>
<div class="col-xl-8 col-lg-8 col-md-9 col-sm-10 col-11" id="navbar-position">
    <div class="card-container experiment-container">
<table class="table">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayName("Experiment")
                    </th>
                    <th>
                        @Html.DisplayName("Acties")
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var userExperiment in Model)
                {
                    <tr>
                        <td>
                            <partial name="ExperimentCard" model="userExperiment.Experiment" />
                        </td>
                        <td>
                            <a class="btn btn-dark m-2 p-2" asp-action="Edit" asp-route-id="@userExperiment.Experiment.experimentId">Bewerk</a>
                            <a class="btn btn-dark m-2 p-2" asp-action="Delete" asp-route-id="@userExperiment.Experiment.experimentId">Verwijder</a>
                        </td>
                    </tr>
                    
                    
                }
            </tbody>
        </table>

        <br><br><br><br><br><br><br><br><br><br>
    </div>
</div>
<div class="col-xl-1 col-lg-1 col-md-1 col-sm-1 col-1"></div>

