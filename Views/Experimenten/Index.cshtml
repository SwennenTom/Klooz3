@model IEnumerable<Klooz3.Models.Experiment>

@{
    ViewData["Title"] = "Experimenten";
}
<p>
    <a asp-action="Create">Nieuw experiment aanmaken</a>
</p>
<div class="col-xl-3 col-lg-3 col-md-2 col-sm-1 col-0"></div>
<div class="col-xl-8 col-lg-8 col-md-9 col-sm-10 col-11" id="navbar-position">
    <div class="card-container experiment-container">

        @foreach (var item in Model)
        {
            <partial name="ExperimentCard" model="item" />
            <a class="btn btn-dark m-2 p-2" asp-action="Edit" asp-route-id="@item.experimentId">Bewerk</a>
            <a class="btn btn-dark m-2 p-2" asp-action="Delete" asp-route-id="@item.experimentId">Verwijder</a>
        }

        <br><br><br><br><br><br><br><br><br><br>
    </div>
</div>
<div class="col-xl-1 col-lg-1 col-md-1 col-sm-1 col-1"></div>
