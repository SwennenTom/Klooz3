@model Klooz3.Models.Experiment

@{
    ViewData["Title"] = "Delete";
}

<h3>Ben je zeker dat je dit experiment wil verwijderen? Dit kan niet ongedaan gemaakt worden.</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.experimentImage)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.experimentImage)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.experimentName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.experimentName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.experimentCardBackText)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.experimentCardBackText)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.experimentShortText)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.experimentShortText)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.experimentPublished)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.experimentPublished)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="experimentId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
