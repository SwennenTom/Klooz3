@model Klooz3.Models.Experiment

@{
    ViewData["Title"] = "Delete";
}
<h3 style="color: red">Ben je zeker dat je dit experiment wil verwijderen? Dit kan niet ongedaan gemaakt worden.</h3>
<a class="btn btn-dark" asp-action="Admin">Terug naar overzicht</a>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Cover afbeelding
        </dt>
        <dd class = "col-sm-10">
            @*@Html.DisplayFor(model => model.experimentImage)*@
            <img style="width: 300px; height: auto;" src="data:image/jpeg;base64,@(Model.experimentImage != null ? Convert.ToBase64String(Model.experimentImage) : string.Empty)" alt="Experiment Image" />
        </dd>
        <dt class = "col-sm-2">
            Naam
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.experimentName)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="experimentId" />
        <input type="submit" value="Delete" class="btn btn-danger" />
    </form>
</div>
