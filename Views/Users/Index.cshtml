@using Microsoft.AspNetCore.Identity
@model List<IdentityUser>

@{
    ViewData["Title"] = "Index";
}

<h2>Gebruikers</h2>

<p>
    <a class="btn btn-dark  @(ViewContext.RouteData.Values["controller"].ToString() == "Administratie" ? "active" : "")"
       href="@Url.Action("Index", "Administratie", new { area = "" })">Terug naar administratie</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayName("Emailadres")
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.UserName)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Bewerk</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Verwijder</a>
                </td>
            </tr>
        }
    </tbody>
</table>

