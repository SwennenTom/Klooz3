@using Microsoft.AspNetCore.Identity
@using Klooz3.ViewModels
@model List<UserWithRolesViewModel>

@{
    ViewData["Title"] = "Index";
}

<h2>Gebruikers</h2>

<p>
    <a class="btn btn-dark  @(ViewContext.RouteData.Values["controller"].ToString() == "Administratie" ? "active" : "")"
       href="@Url.Action("Index", "Administratie", new { area = "" })">Terug naar administratie</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayName("Naam")
            </th>
            <th>
                @Html.DisplayName("Email")
            </th>
            <th>
                @Html.DisplayName("Telefoon")
            </th>
            <th>
                @Html.DisplayName("Organisatie")
            </th>
            <th>
                @Html.DisplayName("Rol")
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var userWithRoles in Model)
        {
            <tr>
                <td>
                    @($"{userWithRoles.User.Firstname} {userWithRoles.User.Lastname}")

                </td>
                <td>
                    @Html.DisplayFor(modelItem => userWithRoles.User.UserName)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => userWithRoles.User.PhoneNumber)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => userWithRoles.User.Organization)
                </td>

                <td>
                    @foreach (var role in userWithRoles.Roles)
                    {
                        @role <br />
                    }
                </td>
                <td>
                    <a class="btn btn-dark" asp-action="Edit" asp-route-id="@userWithRoles.User.Id">Bewerk</a> |
                    <a class="btn btn-dark" asp-action="Delete" asp-route-id="@userWithRoles.User.Id">Verwijder</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

@if (TempData["ErrorMessage"] != null)
{
    <script>
        $(document).ready(function () {
            alert('@TempData["ErrorMessage"]');
        });
    </script>
}
