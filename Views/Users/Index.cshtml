@using Microsoft.AspNetCore.Identity
@using Klooz3.ViewModels
@model List<UserWithRolesViewModel>

@{
    ViewData["Title"] = "Index";
}

<h2>Gebruikers</h2>

<p>
    <a class="btn btn-dark  @(ViewContext.RouteData.Values["controller"].ToString() == "Administratie" ? "active" : "")"
       href="@Url.Action("Index", "Administratie", new { area = "" })">Terug naar administratie</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayName("Gebruiker")
            </th>
            <th>
                @Html.DisplayName("Rol")
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var userWithRoles in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => userWithRoles.User.UserName)
                </td>
                <td>
                    @foreach (var role in userWithRoles.Roles)
                    {
                        @role <br />
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@userWithRoles.User.Id">Bewerk</a> |
                    <a asp-action="Delete" asp-route-id="@userWithRoles.User.Id">Verwijder</a>
                </td>
            </tr>
        }
    </tbody>
</table>

