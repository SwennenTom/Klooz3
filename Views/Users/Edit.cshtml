@using Microsoft.AspNetCore.Identity
@using Klooz3.ViewModels
@model EditUserRolesViewModel

<h2>Edit User Roles: @Model.UserName</h2>

<form asp-action="Edit" asp-route-id="@Model.UserId">
    <div class="form-group">
        <label for="UserName">Username:</label>
        <input asp-for="UserName" class="form-control" disabled />
    </div>

    <div class="form-group">
        <label for="SelectedRole">Role:</label>
        <select asp-for="SelectedRole" asp-items="new SelectList(Model.AvailableRoles)" class="form-control">
            <option value="">Select a Role</option>
        </select>
    </div>

    <button type="submit" class="btn btn-dark m-1">Opslaan</button>
    <div>
        <a class="btn btn-dark" asp-action="Index">Terug naar overzicht</a>
    </div>
</form>
<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

@if (TempData["ErrorMessage"] != null)
{
    <script>
        $(document).ready(function () {
            alert('@TempData["ErrorMessage"]');
        });
    </script>
}