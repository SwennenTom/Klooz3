@using Microsoft.AspNetCore.Identity
@using Klooz3.ViewModels
@model EditUserRolesViewModel

<h2>Edit User Roles: @Model.UserName</h2>

<form asp-action="Edit" asp-route-id="@Model.UserId">
    <div class="form-group">
        <label for="UserName">Username:</label>
        <input asp-for="UserName" class="form-control" disabled />
    </div>

    <div class="form-group">
        <label for="SelectedRole">Role:</label>
        <select asp-for="SelectedRole" asp-items="new SelectList(Model.AvailableRoles)" class="form-control">
            <option value="">Select a Role</option>
        </select>
    </div>

    <button type="submit" class="btn btn-dark">Opslaan</button>
    <div>
        <a class="btn btn-dark  @(ViewContext.RouteData.Values["controller"].ToString() == "Administratie" ? "active" : "")"
           href="@Url.Action("Index", "Administratie", new { area = "" })">Terug naar administratie</a>
    </div>
</form>
