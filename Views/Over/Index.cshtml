@model List<Klooz3.Models.Partner>

@{
    ViewData["Title"] = "Over";
}

<div class="row" id="content">
    <div class="col-xl-5 col-lg-3 col-md-1 col-sm-1 col-0"></div>
    <div class="col-xl-6 col-lg-8 col-md-10 col-sm-10 col-12" id="navbar-position">

        <div class="accordion-flush" id="accordionExample">
            <div class="accordion-item m-1 p-1">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                            data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                        <span class="first-letter-black">W</span>at?
                    </button>
                </h2>
                <div id="collapseOne" class="accordion-collapse collapse"
                     data-bs-parent="#accordionExample">
                    <div class="accordion-body">
                        <p>
                            Klooz is op basis van een ESF-project ontstaan als een inclusief, divers en
                            lerend
                            ecosysteem voor
                            Zuid-Limburg (Borgloon, Tongeren, Wellen en Heers). Het is een pionier
                            project.<br>
                            <br>

                            Het wil dat de welvaart en het welzijn van inwoners in de streek wordt verhoogd
                            door
                            gunstige
                            omstandigheden voor inwoners en bezoekers te creëren rond leren en
                            talentontwikkeling. <br> <br>

                            De ambitie is om van Zuid-Limburg een meer welvarende regio te maken waar de
                            rijke
                            geschiedenis van
                            de streek hand in hand gaat met technologische en streekgebonden innovatie.<br>
                            <br>


                        </p>

                        <h4>Wat is een leerecosysteem?</h4>
                        <div class="embed-responsive embed-responsive-16by9">
                            <iframe class="embed-responsive-item" width="100%" height="315px"
                                    src="https://www.youtube.com/embed/n1CILz4tcoQ"
                                    title="Wat is een leerecosysteem?" allow="autoplay; web-share"
                                    allowfullscreen></iframe>
                        </div>
                        <p>
                            Meer weten over leerecosystemen? Alle info via
                            <a id="link" target="_blank"
                               href="https://www.europawse.be/meer-weten-over-leerecosystemen">
                                Europa Werk
                                en
                                Sociale Economie
                            </a>.
                        </p>

                    </div>
                </div>
            </div>
            <div class="accordion-item m-1 p-1">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                            data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                        <span class="first-letter-black">W</span>aarom?
                    </button>
                </h2>
                <div id="collapseTwo" class="accordion-collapse collapse"
                     data-bs-parent="#accordionExample">
                    <div class="accordion-body">
                        <p>
                            Klooz geeft ruimte om te leren en te experimenteren zodat de deelnemers groeien
                            in
                            zelfontplooiing
                            en ondernemerschap. Door in co-creatie lerende experimenten uit te rollen
                            streeft
                            Klooz naar een
                            meer welvarende en gelukkige Zuid-Limburgse regio.<br><br>
                            Mensen en organisaties engageren zich binnen Klooz door innovatieve voorstellen
                            (smart solutions) te
                            bedenken en uit te voeren voor streekgebonden maatschappelijke uitdagingen
                            (wicked
                            problems). Dat
                            noemen we Klooz-experimenten.<br><br>
                            Elk Klooz-experiment streeft naar een concrete en hedendaagse oplossing waaraan
                            elk
                            van de
                            deelnemers een noodzakelijke bijdrage heeft.<br><br>
                            Klooz staat ook voor een open leerplek op de site van het klooster Nieuwland te
                            Borgloon, met
                            outreachende tentakels naar het karakteristieke landschap en andere locaties in
                            Zuid-Limburg. Zo
                            blijft Klooz dichtbij de doelgroep, grondstoffen en vaardigheden en is de
                            diversiteit van de
                            deelnemers en het leeraanbod gegarandeerd.<br><br>
                            De activiteiten en leerprocessen worden door het Klooz netwerk ruimtelijk,
                            logistiek
                            en inhoudelijk
                            ondersteund, waarbij duurzaamheid, nabijheid en innovatie centraal
                            staan.<br><br>

                            Loes Ory, schepen van toerisme, economie en gezin en bezielster van het
                            projectidee
                            voor Klooz, legt
                            je in deze video uit wat Klooz en een leerecosysteem nu precies is en wat de
                            doelstellingen
                            zijn.<br> <br>
                            <h4>Voorstelling leerecosysteem Zuid-Limburg, Borgloon.</h4>
                            <div class="embed-responsive embed-responsive-16by9">
                                <iframe class="embed-responsive-item" width="100%" height="315px"
                                        src="https://www.youtube.com/embed/aIzjZLE591M"
                                        title="Voorstelling leerecosysteem" allow="autoplay; web-share"
                                        allowfullscreen></iframe>
                            </div>
                            <br><br>

                            Wil je weten waar om net deze kloostersite de ideale plek is voor een
                            leerecosysteem?
                            Jeroen Bellings, architect en schepen dienst woon- en leefomgeving legt het uit
                            in
                            deze
                            video.<br>
                        </p>
                        <h4>De geschiedenis van het Brigittijnenklooster</h4>
                        <iframe width="100%" height="315px" src="https://www.youtube.com/embed/KO-IGn8gf2k"
                                title="Geschiedenis Brigittijnenklooster" frameborder="0"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                allowfullscreen></iframe>
                    </div>
                </div>
            </div>
            <div class="accordion-item m-1 p-1">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                            data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                        <span class="first-letter-black">V</span>oor wie?
                    </button>
                </h2>
                <div id="collapseThree" class="accordion-collapse collapse"
                     data-bs-parent="#accordionExample">
                    <div class="accordion-body">
                        <p>
                            Het doel van Klooz is om sterk verbindend te werken over doelgroepen en sectoren
                            heen. Deze
                            overstijgende werking wordt via 5 streekeigen domeinen uitgewerkt voor een breed
                            publiek.
                        </p>
                        <ul class="notextdecoration" title="5 STREEKEIGEN DOMEINEN">
                            <li>Creatief (21e-eeuwse vaardigheden)</li>
                            <li>Innovatieve fruitteelt/landbouw</li>
                            <li>vrijetijdseconomie</li>
                            <li>duurzaam landelijk toerisme</li>
                            <li>informeel leeraanbod</li>
                        </ul>
                        <p>De doelgroepen die Klooz via deze domeinen wil bereiken zijn:</p>
                        <ul class="notextdecoration">

                            <li>
                                <b>Senioren</b> die zich dichtbij de dagelijkse realiteit (en hun kerndorp
                                of
                                centrumdorp)
                                betekenisvol
                                inzetten en hun eigen leren in handen hebben.
                            </li>
                            <br>
                            <li>
                                <b>Jongeren en jongvolwassenen</b> die hun talenten, passies en interesses
                                kunnen
                                ontdekken entonen
                                en
                                inzetten op (nieuwe) plekken in de streek.
                            </li>
                            <br>
                            <li>
                                <b>Nieuwkomers en autochtone bevolking</b> uit de streek die vanuit een
                                nieuw
                                aanbod
                                leren uit
                                'samen doen
                                en maken'.
                            </li>
                            <br>
                            <li>
                                <b>Werkarme volwassenen</b> die persoonlijk groeien en streekgebonden
                                vaardigheden
                                ontdekken,
                                aanscherpen
                                en kunnen toepassen.
                            </li>
                            <br>
                            <li>
                                <b>De kloostersite (aangekocht door stad Borgloon)</b> dat een veilige leer-
                                en
                                broedplek is voor
                                een
                                nieuwe vorm van leren (intergenerationeel, cross-sectoraal en
                                inclusief).
                            </li>
                            <br>
                            <li>
                                <b>Toeristen</b> die de streek niet alleen bezoeken om te consumeren, maar
                                ook
                                om
                                als toerist willen
                                bijdragen om omgeving nog beter te maken. Zo leveren ze een actieve bijdrage
                                aanregionale
                                ontwikkeling.
                            </li>
                            <br>
                            <li>
                                <b>Lokale verenigingen, ondernemers en kunstenaars</b> die onderzoekend en
                                in
                                co-creatie aanbod op
                                elkaar
                                afstemmen, expertise delen en samen programma maken.
                            </li>
                            <br>
                            <li>
                                <b>Bovenlokale partners</b> die het partnerschap hebben laten uitgroeien tot
                                een
                                netwerk van actoren
                                die samen regionale uitdagingen aanpakken.
                            </li>
                            <br>
                        </ul>
                        <p>
                            Het doel is om dit via het leerecosysteem Klooz neer te zetten als een sterk en
                            zelf
                            renderend merk
                            waarbij de schakels duurzaam en verankerd zijn.
                        </p>

                    </div>
                </div>
            </div>
            <div class="accordion-item m-1 p-1">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                            data-bs-target="#collapseFour" aria-expanded="false" aria-controls="collapseThree">
                        <span class="first-letter-black">M</span>et wie?
                    </button>
                </h2>
                <div id="collapseFour" class="accordion-collapse collapse"
                     data-bs-parent="#accordionExample">
                    <div class="accordion-body">
                        <p>Wij werken samen met deze partners:</p>
                        <div class="row" id="partnerKaarten">
                            <div class="card-container">
                                @foreach (var item in Model)
                                {
                                    <partial name="PartnerCardPartial" model="item"/>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <div class="accordion-item m-1 p-1">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                            data-bs-target="#collapseFive" aria-expanded="false" aria-controls="collapseThree">
                        <span class="first-letter-black">H</span>oe?
                    </button>
                </h2>
                <div id="collapseFive" class="accordion-collapse collapse"
                     data-bs-parent="#accordionExample">
                    <div class="accordion-body">
                        <p>
                            Innovatieve initiatieven oftewel experimenten binnen Klooz voor het antwoord op
                            uit
                            te streekgebonden
                            maatschappelijke uitdagingen worden op basis van een waardenkader met 7 criteria
                            afgetoetst alvorens
                            aanvang. <br><br>Dit is het waardenkader:
                        </p>
                        <ul class="notextdecoration">
                            <li>
                                <b>Verbinding</b> - Klooz is een verbindende samenwerking over sectoren en
                                organisatiestructuren
                                heen. De kritische kruisbestuiving overstijgt de reguliere werking. Klooz,
                                de
                                experimenten en
                                haar activiteiten kunnen niet bestaan zonder dit uniek gegeven.<br><br>
                            </li>
                            <li>
                                <b>Durven, doen en kritisch leren</b> - De activiteiten van Klooz streven
                                een
                                duidelijk
                                omschreven
                                doel na dat past binnen de visie en het betrokken thema en tevens een
                                oplossing
                                voor een
                                maatschappelijke uitdaging eigen aan de streek in zich draagt. We spreken
                                over
                                een duidelijke
                                actie met een tastbare uitwerking. Toch blijven we zelfkritisch en
                                regulerend in
                                de bijsturing
                                bij het streven naar het beoogde doel. Bijleren en ontplooien zijn cruciaal.
                                Falen is
                                toegelaten.
                            </li>
                            <br>
                            <li>
                                <b>Welvarende en gelukkige regio</b> - Klooz en haar activiteit dragen bij
                                tot een
                                meer
                                welvarende
                                en gelukkige regio. Elke activiteit speelt in op minstens 2 van volgende
                                thema's:
                                <ul>
                                    <li>
                                        Innovatieve fruitteelt
                                    </li>
                                    <li>
                                        21e-eeuwse vaardigheden
                                    </li>
                                    <li>
                                        vrijetijdseconomie
                                    </li>
                                    <li>
                                        duurzaam landelijk toerisme
                                    </li>
                                    <li>
                                        informeel leren
                                    </li>
                                </ul><br>
                            </li>
                            <li>
                                <b>Innovatie</b> - Klooz is toekomstgericht en omhelst een - voor de regio -
                                vernieuwend antwoord op
                                een maatschappelijke uitdaging. Het innovatieve, lerend en creatief karakter
                                van
                                het proces is
                                minstens zo belangrijk als het eindresultaat.
                            </li>
                            <br>
                            <li>
                                <b>Laagdrempelig</b> - Alle facetten van Klooz, haar activiteiten en
                                experimenten
                                worden getoetst
                                aan de 9 b’s van toegankelijkheid.
                            </li>
                            <br>
                            <li>
                                <b>Locatie</b> - De site van Klooz, het klooster Nieuwland van Borgloon,
                                vormt de
                                uitvalsbasis. De
                                werking, activiteiten en experimenten mogen zich verspreiden over diverse
                                tentakels in de regio
                                Zuid-Limburg. Experimenten worden bij voorkeur op de site ontwikkeld.
                                Outreachende activiteiten
                                in de regio, het landschap of op betekenisvolle locaties worden via
                                communicatie
                                en huisstijl
                                gelinkt.
                            </li>
                            <br>
                            <li>
                                <b>Duurzaam</b> - Het experiment draagt bij tot een duurzame en lokaal
                                verankerde
                                werking. Daarmee
                                doelen we niet enkel op de ecologische aspecten maar ook op inclusie,
                                economisch
                                verantwoord,
                                met aandacht voor de mens, overwogen keuze van lokale grondstoffen,
                                materialen
                                en diensten waar
                                mogelijk. Levensvatbaarheid van de activiteit op de langere termijn staat
                                hierbij voorop.
                            </li>
                            <br>
                        </ul>
                    </div>
                </div>
            </div>
        </div>


    </div>
    <div class="col-xl-1 col-lg-1 col-md-1 col-sm-1 col-0"></div>
</div>

