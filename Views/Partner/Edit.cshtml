@model Klooz3.Models.Partner

@{
    ViewData["Title"] = "Edit";
}

<hr />
<div class="row">
    <div class="col-md-4">
        <form id="partnerEditForm" asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="partnerId" />
            <div class="form-group">
                <label asp-for="partnerName" class="control-label">Naam</label>
                <input asp-for="partnerName" class="form-control" />
                <span asp-validation-for="partnerName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="partnerAlt" class="control-label">Volledige naam</label>
                <input asp-for="partnerAlt" class="form-control" />
                <span asp-validation-for="partnerAlt" class="text-danger"></span>
            </div>
            <div class="form-group">
                @if (Model.partnerImage != null)
                {
                    <label asp-for="partnerImage" class="control-label">Afbeelding</label>
                    <br />
                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.partnerImage)" alt="Current Image" style="max-width: 200px; max-height: 200px;" />
                    <br />
                }
                <input type="file" name="partnerImageFile" />
                <span asp-validation-for="partnerImage" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="partnerLink" class="control-label">Link</label>
                <input asp-for="partnerLink" class="form-control" />
                <span asp-validation-for="partnerLink" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="partnerDisplayOrder" class="control-label">Prioriteit</label>
                <input asp-for="partnerDisplayOrder" class="form-control" />
                <span asp-validation-for="partnerDisplayOrder" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Opslaan" class="btn btn-dark m-2 p-2" />
                <a class="btn btn-dark m-2 p-2" asp-action="Index">Terug naar overzicht</a>
            </div>
        </form>
    </div>
</div>

@*@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}*@

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" crossorigin="anonymous"></script>
    <script>
        $(document).ready(function () {
            // Handle the form submission using AJAX
            $('#partnerEditForm').submit(function (e) {
                e.preventDefault();
                var form = $(this)[0];
                var formData = new FormData(form);

                $.ajax({
                    url: form.action,
                    type: 'POST',
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        // Handle the success response (data) here if needed
                        // For example, display a success message to the user
                        alert('Image update successful!');
                    },
                    error: function (xhr, status, error) {
                        // Handle the error here if needed
                        // For example, display an error message to the user
                        alert('Image update failed!');
                    }
                });
            });
        });
    </script>
}

