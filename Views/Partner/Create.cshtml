@model Klooz3.Models.Partner

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Partner</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="partnerName" class="control-label"></label>
                <input asp-for="partnerName" class="form-control" />
                <span asp-validation-for="partnerName" class="text-danger"></span>
            </div><br/>
            <div class="form-group">
                @Html.LabelFor(model => model.partnerImage)
                <input type="file" name="PartnerImageFile" />
                @Html.ValidationMessageFor(model => model.partnerImage)
            </div>
            <div class="form-group">
                <label asp-for="partnerLink" class="control-label"></label>
                <input asp-for="partnerLink" class="form-control" />
                <span asp-validation-for="partnerLink" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="partnerDisplayOrder" class="control-label"></label>
                <input asp-for="partnerDisplayOrder" class="form-control" />
                <span asp-validation-for="partnerDisplayOrder" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
