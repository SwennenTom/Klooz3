@model IEnumerable<Klooz3.Models.Partner>

@{
    ViewData["Title"] = "Index";
}

<h1>Overzicht Partners</h1>

<p>
    <a class="btn btn-dark" asp-action="Create">Nieuwe partner</a>
    <a class="btn btn-dark  @(ViewContext.RouteData.Values["controller"].ToString() == "Administratie" ? "active" : "")"
       href="@Url.Action("Index", "Administratie", new { area = "" })">Terug naar overzicht</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayName("Naam")
            </th>
            <th>
                @Html.DisplayName("Afbeelding")
            </th>
            <th>
                @Html.DisplayName("Link")
            </th>
            <th>
                @Html.DisplayName("Prioriteit")
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.partnerName)
            </td>
            <td>
                    <img style="width:64px" src="data:image/jpeg;base64,@Convert.ToBase64String(item.partnerImage)" alt="Partner Image" />
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.partnerLink)
            </td>
                <td>
                    @Html.DisplayFor(modelItem => item.partnerDisplayOrder)
                </td>
            <td>
                <a class="btn btn-dark" asp-action="Edit" asp-route-id="@item.partnerId">Bewerk</a> |
                <a class="btn btn-dark" asp-action="Delete" asp-route-id="@item.partnerId">Verwijder</a>
            </td>
        </tr>
}
    </tbody>
</table>

