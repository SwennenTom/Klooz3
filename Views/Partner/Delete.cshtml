@model Klooz3.Models.Partner

@{
    ViewData["Title"] = "Delete";
}


<h3>Ben je zeker dat je deze partner wil verwijderen?</h3>
<div>
    <hr />
    <dl class="row">
        <dd class = "col-sm-10 display-1">
            @Html.DisplayFor(model => model.partnerName)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="partnerId" />
        <input type="submit" value="Verwijder" class="btn btn-danger p-2 m-2" /> |
        <a class="btn btn-dark" asp-action="Index">Terug naar overzicht</a>
    </form>
</div>
