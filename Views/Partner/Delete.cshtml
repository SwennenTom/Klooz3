@model Klooz3.Models.Partner

@{
    ViewData["Title"] = "Delete";
}

<h1>Verwijderen</h1>

<h3>Ben je zeker dat je deze partner wil verwijderen?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.partnerName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.partnerName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.partnerImage)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.partnerImage)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.partnerLink)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.partnerLink)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="partnerId" />
        <input type="submit" value="Verwijder" class="btn btn-danger" /> |
        <a asp-action="Index">Terug naar overzicht</a>
    </form>
</div>
