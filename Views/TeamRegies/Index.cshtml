@model IEnumerable<Klooz3.Models.TeamRegie>

@{
    ViewData["Title"] = "Index";
}
<p>
    <a class="btn btn-dark" asp-action="Create">Nieuw lid</a>
    <a class="btn btn-dark  @(ViewContext.RouteData.Values["controller"].ToString() == "Administratie" ? "active" : "")"
       href="@Url.Action("Index", "Administratie", new { area = "" })">Terug naar administratie</a>
       <p>De info hier dient alleen om de contactpagina te vullen en geeft geen verdere toegangsrechten.</p>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayName("Naam")
            </th>
            <th>
                @Html.DisplayName("Emailadres")
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Emailadress)
            </td>
            <td>
                <a class="btn btn-dark" asp-action="Edit" asp-route-id="@item.Id">Bewerk</a> |
                <a class="btn btn-dark" asp-action="Delete" asp-route-id="@item.Id">Verwijder</a>
            </td>
        </tr>
}
    </tbody>
</table>
