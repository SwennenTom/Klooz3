@model Klooz3.Models.TeamRegie

@{
    ViewData["Title"] = "Delete";
}
<h3 class="text-danger">Ben je zeker dat je dit lid wil verwijderen? Dit kan niet ongedaan gemaakt worden.</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayName("Naam")
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Verwijder" class="btn btn-danger m-2 p-2" /> |
        <a class="btn btn-dark  @(ViewContext.RouteData.Values["controller"].ToString() == "Administratie" ? "active" : "")"
           href="@Url.Action("Index", "Administratie", new { area = "" })">Terug naar administratie</a>
    </form>
</div>
