@model IEnumerable<Klooz3.Models.Experiment>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.experimentImage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.experimentName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.experimentCardFrontText)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.experimentCardBackText)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.categories)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.experimentShortText)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.experimentKickOffDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.experimentEndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.experimentwickedProblemsToSmartSolutions)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.experimenttargetAndImpact)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.experimentTouchstone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.experimentPhotos)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.experimentPublished)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.experimentCreatedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.experimentLastModified)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.experimentStatus)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.experimentImage)
                    @*<img style="width:64px" src="data:image/jpeg;base64,@Convert.ToBase64String(item.experimentImage)" alt="Experiment Image" />*@
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.experimentName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.experimentCardFrontText)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.experimentCardBackText)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.categories.name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.experimentShortText)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.experimentKickOffDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.experimentEndDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.experimentwickedProblemsToSmartSolutions)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.experimenttargetAndImpact)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.experimentTouchstone)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.experimentPhotos)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.experimentPublished)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.experimentCreatedDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.experimentLastModified)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.experimentStatus)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.experimentId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.experimentId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.experimentId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
