@model IEnumerable<Klooz3.Models.Experiment>

@{
    ViewData["Title"] = "Index";
}

<h1>Experimenten administratie</h1>

<p>
    <a asp-action="Create">Nieuw experiment</a>
</p>
<a class="btn btn-dark  @(ViewContext.RouteData.Values["controller"].ToString() == "Administratie" ? "active" : "")"
   href="@Url.Action("Index", "Administratie", new { area = "" })">Terug naar administratie</a>
<table class="table">
    <thead>
        <tr>
            <th>
                Cover afbeelding
            </th>
            <th>
                Naam
            </th>
            
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
            <partial name="ExperimentCard" model="item" />
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.experimentImage)
                    @*<img style="width:64px" src="data:image/jpeg;base64,@Convert.ToBase64String(item.experimentImage)" alt="Experiment Image" />*@
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.experimentName)
            </td>
            
            <td>
                <a asp-action="Edit" asp-route-id="@item.experimentId">Bewerk</a> |
                <a asp-action="Details" asp-route-id="@item.experimentId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.experimentId">Verwijder</a>
            </td>
        </tr>
}
    </tbody>
</table>
