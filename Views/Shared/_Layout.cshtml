<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
          content="Over-pagina met gedetailleerde beschrijving van het hoe en waarom van Project Klooz - leerecosysteem">

    <title>Project Klooz</title>

    <link defer rel="icon" href="/img/favicon.webp">
    <link async rel="stylesheet" href="/css/style2.css">

    <link defer href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-GLhlTQ8iRABdZLl6O3oVMWSktQOp6b7In1Zl3/Jr59b6EGGoI1aFkw7cmDA6j6gD" crossorigin="anonymous">

    <script defer src="https://code.jquery.com/jquery-latest.min.js" type="text/javascript"></script>
    <script defer async src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-w76AqPfDkMBDXo30jS1Sgez6pr3x5MlQ1ZAGC+nuZB+EYdgRZgiwxhTBTkF7CXvN"
            crossorigin="anonymous"></script>
    <script defer src="/script/script.js"></script>

    <script defer type="text/javascript" src="config.js"></script>
    <script defer type="text/javascript" src="https://cdn.kiprotect.com/klaro/v0.7.18/klaro.js"></script>
</head>
<body>
    <!-- Torentje image in bottom right-->
    <div class="col-12 z-3">
        <img src="/img/Placeholder/PLACEHOLDER_Toren-Transparent.webp" alt=""
             class="position-fixed bottom-0 end-0 TorenImage">
    </div>

    <!-- Navbar fully collapsible-->
    <header id="top">
        
        <nav class="navbar navbar-expand-lg bg-body-white sticky-top">
            <div class="container-fluid">
                <a asp-page="/Index">
                    <img src="/img/KloozLogo/PLACEHOLDER_kloozlogo01_TRANSPARANT.webp" width="234px"
                         alt="Welkom op de website van Project Klooz, leerecosysteem">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse nav" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link p-0 @(ViewContext.RouteData.Values["controller"].ToString() == "Over" ? "active" : "")"
                               href="@Url.Action("Index", "Over", new { area = "" })">OVER</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link p-0 @(ViewContext.RouteData.Values["controller"].ToString() == "Experimenten" ? "active" : "")"
                               href="@Url.Action("Index", "Experimenten", new { area = "" })">EXPERIMENTEN</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link p-0 @(ViewContext.RouteData.Values["controller"].ToString() == "Contact" ? "active" : "")"
                               href="@Url.Action("Index", "Contact", new { area = "" })">CONTACT</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link p-0 @(ViewContext.RouteData.Values["controller"].ToString() == "Agenda" ? "active" : "")"
                               href="@Url.Action("Index", "Agenda", new { area = "" })">AGENDA</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-auto py-3">
        <div class="row">
            <div class="col-10">
                <nav>
                    <a target=”_blank” href="https://borgloon.be/">
                        <img src="/img/FooterLogos/logo-borgloon (1).webp"
                             alt="Link naar de website van de Stad Borgloon" class="footerlogo">
                    </a>
                    <a target=”_blank” href="https://ec.europa.eu/european-social-fund-plus/nl">
                        <img src="/img/FooterLogos/esflogo_large.webp"
                             alt="Link naar de website van het Europees Sociaal Fonds" class="footerlogo">
                    </a>
                    <a target=”_blank” href="https://www.lidk.be/">
                        <img src="/img/FooterLogos/lidk_logofull_color_1600x1240.webp"
                             alt="Link naar de website van VZW Link in de Kabel" class="footerlogo">
                    </a>
                </nav>
            </div>
            <div class="col-2"></div>
        </div>
        <p id="copyright">
            &copy;
            <script>
                var currentYear = new Date().getFullYear();
                var firstYear = 2023;
                var displayYear = (currentYear > firstYear) ? `${firstYear} - ${currentYear}` : currentYear;
                document.write(displayYear);
            </script> <a target="_blank" id="linkdeco" href="https://www.lidk.be/">VZW Link in de Kabel</a> - <a href="/html/privacy.html" id="linkdeco">Privacy beleid</a>
        </p>
    </footer>

    <!-- Cookies consent popup-->

    <script type="text/javascript" src="https://cookieconsent.popupsmart.com/src/js/popper.js"></script>
    <script>window.start.init({ Palette: "palette1", Mode: "banner bottom", Theme: "classic", LinkText: "Meer informatie", Message: "Deze website gebruikt cookies om u de beste ervaring te geven.", ButtonText: "Akkoord!", Time: "5", })</script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
