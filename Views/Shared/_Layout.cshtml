<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
          content="Over-pagina met gedetailleerde beschrijving van het hoe en waarom van Project Klooz - leerecosysteem">

    <title>Project Klooz</title>

    <link defer rel="icon" href="/img/favicon.webp">
    <link async rel="stylesheet" href="/css/style2.css">

    <link defer href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-GLhlTQ8iRABdZLl6O3oVMWSktQOp6b7In1Zl3/Jr59b6EGGoI1aFkw7cmDA6j6gD" crossorigin="anonymous">

    <script defer src="https://code.jquery.com/jquery-latest.min.js" type="text/javascript"></script>
    <script defer async src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-w76AqPfDkMBDXo30jS1Sgez6pr3x5MlQ1ZAGC+nuZB+EYdgRZgiwxhTBTkF7CXvN"
            crossorigin="anonymous"></script>
    <script defer src="/script/script.js"></script>

    <script defer type="text/javascript" src="config.js"></script>
    <script defer type="text/javascript" src="https://cdn.kiprotect.com/klaro/v0.7.18/klaro.js"></script>
</head>
<body>
    <!-- Torentje image in bottom right-->
    <div class="col-12 z-3">
        <img src="/img/Placeholder/PLACEHOLDER_Toren-Transparent.webp" alt=""
             class="position-fixed bottom-0 end-0 TorenImage">
    </div>
    <div class="float-end">
        <partial name="_LoginPartial" />
    </div>

    <!-- Navbar fully collapsible-->
    <header id="top">
        
        <nav class="navbar navbar-expand-lg bg-body-white sticky-top">
            <div class="container-fluid">
                <a asp-page="/Index">
                    <img src="/img/KloozLogo/PLACEHOLDER_kloozlogo01_TRANSPARANT.webp" width="234px"
                         alt="Welkom op de website van Project Klooz, leerecosysteem">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse nav" id="navbarSupportedContent">
                    @{
                        // Define a list of menu items with their respective controller names and display names
                        var menuItems = new List<(string Controller, string DisplayName)>
                    {
                    ("Over", "OVER"),
                    ("Experimenten", "EXPERIMENTEN"),
                    ("Contact", "CONTACT"),
                    ("Agenda", "AGENDA")
                    };
                    }

                    <ul class="nav">
                        @foreach (var menuItem in menuItems)
                        {
                            <li class="nav-item">
                                <a class="nav-link p-0 @(ViewContext.RouteData.Values["controller"]?.ToString() == menuItem.Controller ? "active" : "")"
                                   href="@Url.Action("Index", menuItem.Controller, new { area = "" })">@menuItem.DisplayName</a>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-auto py-3">
        <div class="row">
            <div class="col-10">
                <nav>
                    <a target=”_blank” href="https://borgloon.be/">
                        <img src="/img/FooterLogos/logo-borgloon (1).webp"
                             alt="Link naar de website van de Stad Borgloon" class="footerlogo">
                    </a>
                    <a target=”_blank” href="https://ec.europa.eu/european-social-fund-plus/nl">
                        <img src="/img/FooterLogos/esflogo_large.webp"
                             alt="Link naar de website van het Europees Sociaal Fonds" class="footerlogo">
                    </a>
                    <a target=”_blank” href="https://www.lidk.be/">
                        <img src="/img/FooterLogos/lidk_logofull_color_1600x1240.webp"
                             alt="Link naar de website van VZW Link in de Kabel" class="footerlogo">
                    </a>
                </nav>
            </div>
            <div class="col-2"></div>
        </div>
        <p id="copyright">
            &copy;
            <script>
                var currentYear = new Date().getFullYear();
                var firstYear = 2023;
                var displayYear = (currentYear > firstYear) ? `${firstYear} - ${currentYear}` : currentYear;
                document.write(displayYear);
            </script> 
            <a target="_blank" id="linkdeco" href="https://www.lidk.be/">VZW Link in de Kabel</a> -
            <a class="nav-link p-0 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Privacy" ? "active" : "")"
               href="@Url.Action("Index", "Privacy", new { area = "" })">Privacy beleid</a>

        </p>
    </footer>

    <!-- Cookies consent popup-->

    <div class="cookie-consent-overlay">
        <div id="cookieConsent" class="cookie-consent">
            <p>
                Deze website gebruikt cookies om uw ervaring te verbeteren.
                <a class="nav-link p-0 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Privacy" ? "active" : "")"
                   href="@Url.Action("Index", "Privacy", new { area = "" })">Privacy beleid</a>

            </p>
            <div class="buttons">
                <button id="acceptCookiesButton" class="cookie-consent-button">Ok!</button>
                <button id="refuseCookiesButton" class="cookie-consent-button">Liever niet</button>
            </div>
        </div>
    </div>

    <script>
        // Function to set the cookie for consent
        function setCookie(name, value, days) {
            var expires = "";
            if (days) {
                var date = new Date();
                date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
                expires = "; expires=" + date.toUTCString();
            }
            document.cookie = name + "=" + (value || "") + expires + "; path=/";
        }

        // Function to hide the cookie consent popup
        function hideCookieConsent() {
            var cookieConsentPopup = document.getElementById("cookieConsent");
            var cookieConsentOverlay = document.querySelector(".cookie-consent-overlay");

            cookieConsentPopup.style.display = "none";
            cookieConsentOverlay.style.display = "none";
        }

        // Function to reset the cookie consent status
        function resetCookieConsent() {
            setCookie("cookieConsent", "", -1); // Delete the consent cookie
            var cookieConsentPopup = document.getElementById("cookieConsent");
            var cookieConsentOverlay = document.querySelector(".cookie-consent-overlay");

            cookieConsentPopup.style.display = "block"; // Display the popup again
            cookieConsentOverlay.style.display = "block"; // Display the overlay again
        }

        // Function to handle the Accept button click
        function handleAcceptClick() {
            setCookie("cookieConsent", "accepted", 365); // Cookie will expire after 1 year
            console.log("Accepted");
            hideCookieConsent();
        }

        // Function to handle the Refuse button click
        function handleRefuseClick() {
            setCookie("cookieConsent", "refused", 365); // Cookie will expire after 1 year
            console.log("refused");
            hideCookieConsent();
        }

        // Check if the consent cookie exists
        if (!document.cookie.includes("cookieConsent=")) {
            console.log("cookieConsentCheck performed");
            document.addEventListener("DOMContentLoaded", function () {
                var acceptCookiesButton = document.getElementById("acceptCookiesButton");
                acceptCookiesButton.addEventListener("click", handleAcceptClick);

                var refuseCookiesButton = document.getElementById("refuseCookiesButton");
                refuseCookiesButton.addEventListener("click", handleRefuseClick);

                var cookieConsentPopup = document.getElementById("cookieConsent");
                cookieConsentPopup.style.display = "block";
            });
        } else {
            hideCookieConsent();
        }

        // Add event listener for the "Wijzig cookie instellingen" link
        var changeCookieSettingsLink = document.getElementById("changeCookieSettingsLink");
        changeCookieSettingsLink.addEventListener("click", function (event) {
            event.preventDefault(); // Prevent the link from navigating to a new page
            resetCookieConsent(); // Reset the cookie consent status and display the popup again
        });
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
