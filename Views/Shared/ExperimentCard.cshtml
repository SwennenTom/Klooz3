@model Klooz3.Models.Experiment

<script>
    function openExperimentModal(experimentId) {
        
        $.ajax({
            type: "GET",
            url: "/Experimenten/GetExperimentDetails/" + experimentId,
            success: function (data) {
                // Update modal content with fetched details
                $('#experimentModalLabel').text(data.experimentName);
                $('#experimentImageModal').attr('src', 'data:image/png;base64,' + data.experimentImage);
                $('#experimentShortTextModal').text(data.experimentShortText);
                $('#experimentShortTextModal').css('word-wrap', 'break-word');

                // Show the modal
                $('#experimentModal').modal('show');
            },
            error: function () {
                alert("Error fetching experiment details.");
            }
        });
    }
</script>


<div class="card experimentcard" onclick="flipCard(this)">
    <a href="#top" target="" class="card-front">
        <div class="d-flex align-items-center justify-content-center">
            @if (Model.experimentImage != null)
            {
                <img class="experimentsizer center-image" src="data:image/png;base64,@Convert.ToBase64String(Model.experimentImage)" alt="Experiment Image">
            }
        </div>
        <div class="card-body">
            <h5 class="card-title text-center">@Model.experimentName</h5>
        </div>
    </a>
    <div class="card-back invisible ms-1">
        <h5 class="text-center">@Model.experimentName</h5><br>
        <p>
            @Model.experimentCardBackText
        </p>
        @* <a  class="fw-bolder" href="/experimenten/experiment1.html">Lees meer...</a> *@
        <button class="btn btn-dark" onclick="openExperimentModal(@Model.experimentId)">Lees meer...</button>

    </div>
</div>

<div class="modal fade" id="experimentModal" tabindex="-1" role="dialog" aria-labelledby="experimentModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="experimentModalLabel"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body justify-content-center text-center">
                <br />
                <img id="experimentImageModal" class="experimentsizer center-image" alt="Experiment Image">
                <br /><br />
                <textarea rows="20" style="width: 100%;" id="experimentShortTextModal" readonly></textarea><br />
            </div>
        </div>
    </div>
</div>
