@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a  class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Welkom @User.Identity?.Name!</a>
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link btn btn-dark text-light">Uitloggen</button>
            </form>
    </li>
}
else
{
    <li class="nav-item">
            <a class="btn btn-light text-muted asp-area="Identity" asp-page="/Account/Register">Registreren</a>
            <a class="btn btn-light text-muted" asp-area="Identity" asp-page="/Account/Login">Inloggen</a>
    </li>
}
</ul>
