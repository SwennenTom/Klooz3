@model Klooz3.Models.Partner

<div class="card partnercard">
    <a href=@Model.partnerLink target="_blank">
        <div class="imgSizer d-flex align-items-center">
            <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.partnerImage)" class="card-img-top"
                 alt=@Model.partnerName>
        </div>
        <div class="card-body">
            <h5 class="card-title text-center">@Model.partnerName</h5>
            <p class="card-text"></p>
        </div>
    </a>
</div>
